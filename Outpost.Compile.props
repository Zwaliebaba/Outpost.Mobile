<?xml version="1.0" encoding="utf-8"?>
<!--
  Compiler and linker settings, shared by every project in the solution.

  Imported from each .vcxproj's PropertySheets ImportGroup, after Microsoft.Cpp.props. The toolset
  and the configuration flavour are decided earlier, in Outpost.Toolset.props.

  Two of these are load-bearing rather than a matter of taste:

    * ConformanceMode. Turning it off to make something compile trades one afternoon for every
      afternoon after it.
    * /fp:precise and no /arch. GameLogic is deterministic, and determinism is a property of the
      whole binary: a floating-point mode or an instruction set that differs between two projects
      makes the same tick produce two answers, and the replay suite goes red months later for a
      reason nobody can find. They are set here, once, for everything.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    A numeric comparison against an empty $(VisualStudioVersion) is MSB4086, not a false condition,
    so msbuild invoked outside a Visual Studio context fails on the first project it evaluates.
    Both sheets set this the same way and the second set is a no-op; neither may assume the other
    ran first, because a project could one day import only one of them.
  -->
  <PropertyGroup>
    <OutpostVsVersion Condition="'$(OutpostVsVersion)'=='' and '$(VisualStudioVersion)'!=''">$(VisualStudioVersion)</OutpostVsVersion>
    <OutpostVsVersion Condition="'$(OutpostVsVersion)'==''">17.0</OutpostVsVersion>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <!-- stdcpp20 is the floor, and where the version is unknown it is what CI compiles against.
           Nothing in this tree may need C++23 to build; if something does, it has to be behind a
           feature test, because the two standards then disagree at your desk before they disagree
           in CI. -->
      <LanguageStandard Condition="'$(OutpostVsVersion)' &gt;= '18.0'">stdcpplatest</LanguageStandard>
      <LanguageStandard Condition="'$(OutpostVsVersion)' &lt; '18.0'">stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <FloatingPointModel>Precise</FloatingPointModel>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <AdditionalOptions>%(AdditionalOptions) /bigobj</AdditionalOptions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>Disabled</Optimization>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
