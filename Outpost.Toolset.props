<?xml version="1.0" encoding="utf-8"?>
<!--
  Toolset settings, shared by every project in the solution.

  Imported at the TOP of each .vcxproj, ahead of Microsoft.Cpp.Default.props, because a toolset and
  a configuration flavour have to be decided before the platform defaults fill them in. The
  compiler switches live in the other sheet, Outpost.Compile.props, which is imported from the
  PropertySheets group instead; the two positions are not interchangeable.

  Nothing here belongs in a project file. A setting spelled per project drifts, and the one it
  drifts on is always the one that mattered -- which is how Release came to be built with debug
  libraries and _DEBUG defined, and stayed that way.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    A numeric comparison against an empty $(VisualStudioVersion) is MSB4086, not a false condition,
    so msbuild invoked outside a Visual Studio context fails on the first project it evaluates.
    Both sheets set this the same way and the second set is a no-op; neither may assume the other
    ran first, because a project could one day import only one of them.
  -->
  <PropertyGroup>
    <OutpostVsVersion Condition="'$(OutpostVsVersion)'=='' and '$(VisualStudioVersion)'!=''">$(VisualStudioVersion)</OutpostVsVersion>
    <OutpostVsVersion Condition="'$(OutpostVsVersion)'==''">17.0</OutpostVsVersion>
  </PropertyGroup>

  <PropertyGroup Label="Globals">
    <!-- v145 ships with Visual Studio 2026, v143 with 2022. Pinned only when msbuild says which
         one is running: setup-msbuild on a CI runner leaves $(VisualStudioVersion) empty, and
         pinning a toolset that is not installed fails harder than not pinning one, so in that
         case Microsoft.Cpp.Default.props picks whatever the machine actually has. -->
    <PlatformToolset Condition="'$(VisualStudioVersion)'!='' and '$(OutpostVsVersion)' &gt;= '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)'!='' and '$(OutpostVsVersion)' &lt; '18.0'">v143</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Debug'">
    <UseDebugLibraries>true</UseDebugLibraries>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>

  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Release'">
    <!-- Release links the release CRT and enables the optimiser. It did neither before this sheet
         existed, which made every measurement taken in Release a measurement of a debug build. -->
    <UseDebugLibraries>false</UseDebugLibraries>
    <LinkIncremental>false</LinkIncremental>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
</Project>
