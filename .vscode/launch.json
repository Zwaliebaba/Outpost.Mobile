{
  // Outpost is Windows/MSVC only, so every configuration uses the Visual Studio debugger.
  //
  // The build is MSBuild, not CMake: Outpost.slnx is the solution, and the executable lands in
  // x64\<Configuration>\Outpost.exe. Build it first (AGENTS.md 6) -- these configurations launch
  // what is already there rather than building it.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Outpost (x64)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/x64/Debug/Outpost.exe",
      "args": [],
      "stopAtEntry": false,
      // Assets are resolved relative to the executable, not the working directory, so this only
      // decides where any files the game writes end up.
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "internalConsole"
    },
    {
      "name": "Release Outpost (x64)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/x64/Release/Outpost.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "internalConsole"
    },
    {
      "name": "Attach to Outpost",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
