  <!-- Start of the shared compiler block. Carried verbatim by every project, like the toolset
       block above. Two of these are load-bearing rather than a matter of taste:

         * ConformanceMode. Turning it off to make something compile trades one afternoon for
           every afternoon after it.
         * /fp:precise and no /arch. GameLogic is deterministic, and determinism is a property of
           the whole binary: a floating-point mode that differs between two projects makes the
           same tick produce two answers, and the replay suite goes red months later for a reason
           nobody can find. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- stdcpp20 is the floor, and where the version is unknown it is what gets compiled.
           Nothing in this tree may need C++23 to build; if something does, it goes behind a
           feature test, because the two standards then disagree at your desk before they disagree
           in CI. -->
      <LanguageStandard Condition="'$(OutpostVsVersion)' &gt;= '18.0'">stdcpplatest</LanguageStandard>
      <LanguageStandard Condition="'$(OutpostVsVersion)' &lt; '18.0'">stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <FloatingPointModel>Precise</FloatingPointModel>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <AdditionalOptions>%(AdditionalOptions) /bigobj</AdditionalOptions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>Disabled</Optimization>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <!-- End of the shared compiler block. -->
  <!--
    Shaders. FXC compiles them at build time into headers under CompiledShaders, so a shader
    mistake is a build error rather than a message box on somebody's machine and the binary carries
    no dependency on d3dcompiler_47.dll. What differs per file – whether it is a vertex or a pixel
    shader, where its header goes and what the array is called – is spelled on the FxCompile item,
    because that mapping is the thing a reviewer needs to see.
  -->
  <ItemDefinitionGroup>
    <FxCompile>
      <ShaderModel>5.1</ShaderModel>
      <!-- One entry point per file, so it does not need a name of its own. -->
      <EntryPointName>main</EntryPointName>
      <!-- Header output only; the default writes a .cso beside the binary that nothing loads. -->
      <ObjectFileOutput />
      <!-- /Ges: strict mode. The old runtime path passed D3DCOMPILE_ENABLE_STRICTNESS and this is
           the same switch, so a shader that compiled before still compiles now. -->
      <AdditionalOptions>%(AdditionalOptions) /Ges</AdditionalOptions>
    </FxCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <FxCompile>
      <EnableDebuggingInformation>true</EnableDebuggingInformation>
      <DisableOptimizations>true</DisableOptimizations>
    </FxCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_LIB;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- The include path is not the dependency rule, but it is where breaking one starts. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\NeuronCore;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
