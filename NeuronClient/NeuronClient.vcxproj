  <!-- Start of the shared toolset block. Every project in this solution carries it verbatim, and
       Build/CheckProjectFiles.py fails the build before anything is compiled if a copy drifts.

       It sits ahead of Microsoft.Cpp.Default.props because a toolset and a configuration flavour
       have to be decided before the platform defaults fill them in.

       PlatformToolset is pinned only when msbuild reports which Visual Studio is running, and an
       empty PlatformToolset is not a safe default for the other case: Microsoft.Cpp.Default.props
       then falls all the way back to v100, and the build stops with MSB8020 naming Visual Studio
       2010 on a runner that has 2026 installed. Pinning a toolset that is not installed fails the
       same way, which is why the version is read rather than assumed. -->
  <PropertyGroup>
    <!-- A numeric comparison against an empty $(VisualStudioVersion) is MSB4086, not a false
         condition, so msbuild invoked outside a Visual Studio context would fail here rather than
         fall through to the floor below. -->
    <OutpostVsVersion Condition="'$(OutpostVsVersion)'=='' and '$(VisualStudioVersion)'!=''">$(VisualStudioVersion)</OutpostVsVersion>
    <OutpostVsVersion Condition="'$(OutpostVsVersion)'==''">17.0</OutpostVsVersion>
  </PropertyGroup>
  <PropertyGroup Label="Globals">
    <!-- v145 ships with Visual Studio 2026, v143 with 2022. -->
    <PlatformToolset Condition="'$(VisualStudioVersion)'!='' and '$(OutpostVsVersion)' &gt;= '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(VisualStudioVersion)'!='' and '$(OutpostVsVersion)' &lt; '18.0'">v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Debug'">
    <UseDebugLibraries>true</UseDebugLibraries>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)'=='Release'">
    <!-- Release links the release CRT and enables the optimiser. It did neither once, which made
         every number measured in Release a measurement of a debug build. -->
    <UseDebugLibraries>false</UseDebugLibraries>
    <LinkIncremental>false</LinkIncremental>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <!-- End of the shared toolset block. -->
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
